---
/**
 * Форма заявки с честными состояниями. Без вебхука (PUBLIC_ORDER_ENDPOINT) успех не изображается:
 * форма собирает текст заявки и предлагает отправить его в мессенджер или позвонить.
 *
 * <OrderForm title="Отложить на самовывоз" itemsLabel="Что отложить" whenOptions={['Сегодня','Завтра']} />
 */
import { business, orderEndpoint } from '../data/site';

interface Props {
  title?: string;
  submitLabel?: string;
  itemsLabel?: string;
  itemsPlaceholder?: string;
  whenOptions?: string[];
  successText?: string;
}
const {
  title = 'Оставить заявку',
  submitLabel = 'Отправить заявку',
  itemsLabel = 'Что нужно',
  itemsPlaceholder = '',
  whenOptions = [],
  successText = 'Заявка отправлена. Перезвоним в рабочее время.',
} = Astro.props;
const wa = business.links.whatsapp;
const tg = business.links.telegram;
---
<form class="order" data-order data-endpoint={orderEndpoint} data-wa={wa} data-tg={tg} data-phone={business.phone.e164} novalidate>
  <h3 class="order-title">{title}</h3>

  <div class="f">
    <label for="of-items">{itemsLabel}</label>
    <textarea id="of-items" name="items" rows="2" placeholder={itemsPlaceholder}></textarea>
  </div>
  <div class="f">
    <label for="of-name">Имя</label>
    <input id="of-name" name="name" autocomplete="given-name" required aria-describedby="of-name-err" />
    <p class="err" id="of-name-err" hidden>Как к вам обращаться?</p>
  </div>
  <div class="f">
    <label for="of-phone">Телефон</label>
    <input id="of-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" required placeholder="+7 (___) ___-__-__" aria-describedby="of-phone-err" />
    <p class="err" id="of-phone-err" hidden>Нужен номер из 11 цифр, чтобы перезвонить.</p>
  </div>
  {whenOptions.length > 0 && (
    <div class="f">
      <label for="of-when">Когда удобно</label>
      <select id="of-when" name="when">{whenOptions.map((o) => <option>{o}</option>)}</select>
    </div>
  )}
  <div class="f">
    <label for="of-comment">Комментарий</label>
    <textarea id="of-comment" name="comment" rows="2"></textarea>
  </div>
  <input class="hp" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="f consent">
    <input id="of-consent" name="consent" type="checkbox" required aria-describedby="of-consent-err" />
    <label for="of-consent">Согласен на обработку персональных данных по <a href={`${import.meta.env.BASE_URL}privacy`}>политике конфиденциальности</a></label>
    <p class="err" id="of-consent-err" hidden>Без согласия мы не можем принять заявку (152-ФЗ).</p>
  </div>
  <button class="submit" type="submit">{submitLabel}</button>

  <div class="result" role="status" aria-live="polite"></div>
  <div class="fallback" hidden>
    <p>Отправьте заявку одним касанием — текст уже готов:</p>
    <div class="fb-links">
      {wa && <a class="fb" data-fb="wa" href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a>}
      {tg && <a class="fb" data-fb="tg" href={`https://t.me/${tg}`} target="_blank" rel="noopener">Telegram</a>}
      <a class="fb" data-fb="sms" href={`sms:${business.phone.e164}`}>SMS</a>
      <a class="fb" href={`tel:${business.phone.e164}`}>Позвонить</a>
    </div>
  </div>
  <template data-success>{successText}</template>
</form>

<script>
  const digits = (s: string) => s.replace(/\D/g, '');
  const fmt = (v: string) => {
    let d = digits(v);
    if (d.startsWith('8')) d = '7' + d.slice(1);
    if (!d.startsWith('7')) d = '7' + d;
    d = d.slice(0, 11);
    const p = [d.slice(1, 4), d.slice(4, 7), d.slice(7, 9), d.slice(9, 11)];
    let out = '+7';
    if (p[0]) out += ` (${p[0]}`;
    if (p[0].length === 3) out += ')';
    if (p[1]) out += ` ${p[1]}`;
    if (p[2]) out += `-${p[2]}`;
    if (p[3]) out += `-${p[3]}`;
    return out;
  };

  document.querySelectorAll<HTMLFormElement>('form[data-order]').forEach((form) => {
    const phone = form.querySelector<HTMLInputElement>('[name=phone]')!;
    const result = form.querySelector<HTMLElement>('.result')!;
    const fallback = form.querySelector<HTMLElement>('.fallback')!;
    const button = form.querySelector<HTMLButtonElement>('.submit')!;
    const success = form.querySelector<HTMLTemplateElement>('template[data-success]')!.innerHTML;

    phone.addEventListener('input', () => { phone.value = fmt(phone.value); });

    const check = (name: string, ok: boolean) => {
      const input = form.querySelector<HTMLInputElement>(`[name=${name}]`)!;
      const err = form.querySelector<HTMLElement>(`#of-${name}-err`);
      input.setAttribute('aria-invalid', String(!ok));
      if (err) err.hidden = ok;
      return ok;
    };
    form.querySelectorAll('input[required]').forEach((el) =>
      el.addEventListener('blur', () => {
        const n = (el as HTMLInputElement).name;
        if (n === 'phone') check('phone', digits(phone.value).length === 11);
        else if (n === 'name') check('name', (el as HTMLInputElement).value.trim().length > 1);
      }));

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.company) return; // ловушка для ботов
      const ok = [
        check('name', (data.name || '').trim().length > 1),
        check('phone', digits(data.phone || '').length === 11),
        check('consent', !!data.consent),
      ].every(Boolean);
      if (!ok) { form.querySelector<HTMLElement>('[aria-invalid=true]')?.focus(); return; }

      const text = [`Заявка с сайта`, data.items && `Что: ${data.items}`, `Имя: ${data.name}`, `Телефон: ${data.phone}`,
        data.when && `Когда: ${data.when}`, data.comment && `Комментарий: ${data.comment}`].filter(Boolean).join('\n');
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        // Вебхук не подключён: честно предлагаем отправить текст самим, без имитации успеха.
        const enc = encodeURIComponent(text);
        form.querySelectorAll<HTMLAnchorElement>('[data-fb]').forEach((a) => {
          if (a.dataset.fb === 'wa') a.href = `https://wa.me/${form.dataset.wa}?text=${enc}`;
          if (a.dataset.fb === 'tg') a.href = `https://t.me/${form.dataset.tg}?text=${enc}`;
          if (a.dataset.fb === 'sms') a.href = `sms:${form.dataset.phone}?&body=${enc}`;
        });
        fallback.hidden = false;
        result.textContent = 'Заявка собрана. Выберите, куда её отправить.';
        return;
      }

      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      result.textContent = 'Отправляем…';
      try {
        const r = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ...data, text }) });
        if (!r.ok) throw new Error(String(r.status));
        form.reset();
        result.textContent = success;
      } catch {
        result.textContent = 'Не получилось отправить. Позвоните нам или напишите в мессенджер — ссылки ниже.';
        fallback.hidden = false;
      } finally {
        button.disabled = false;
        button.removeAttribute('aria-busy');
      }
    });
  });
</script>

<style>
  .order { display: grid; gap: var(--s-4); max-width: 34rem; }
  .order-title { font-size: var(--t-h3); }
  .f { display: grid; gap: var(--s-1); }
  label { font-weight: 600; font-size: var(--t-small); }
  input, textarea, select {
    font: inherit; color: var(--c-text); background: var(--c-bg);
    border: 1px solid var(--c-border); border-radius: var(--r-md);
    min-height: var(--tap); padding: var(--s-3) var(--s-4); width: 100%; box-sizing: border-box;
  }
  input[aria-invalid=true] { border-color: var(--c-danger); }
  .err { color: var(--c-danger); font-size: var(--t-small); margin: 0; }
  .consent { grid-template-columns: auto 1fr; align-items: start; column-gap: var(--s-3); }
  .consent input { width: 24px; min-height: 24px; height: 24px; margin-top: 2px; padding: 0; }
  .consent .err { grid-column: 1 / -1; }
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .submit {
    min-height: var(--tap); border: 0; border-radius: var(--r-md); cursor: pointer;
    background: var(--c-accent); color: var(--c-on-accent); font: 600 1.05rem/1 var(--f-body); padding: 0 var(--s-6);
    transition: transform var(--d-micro) var(--e-out);
  }
  .submit:active { transform: scale(0.98); }
  .submit[aria-busy=true] { opacity: 0.7; cursor: progress; }
  .result:empty { display: none; }
  .fb-links { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .fb { min-height: var(--tap); display: inline-flex; align-items: center; padding: 0 var(--s-4); border: 1px solid var(--c-border); border-radius: var(--r-md); text-decoration: none; font-weight: 600; }
</style>
