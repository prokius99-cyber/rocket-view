---
/** Секция visit — финальный плакат: маршрут по наклейкам к кнопке звонка (DESIGN.md §5, С1). */
import { business } from '../data/site';

const { address, phone, links, hoursDisplay } = business;
const hours = hoursDisplay.charAt(0).toUpperCase() + hoursDisplay.slice(1);
---
<section class="visit section-y" data-section="visit" data-trail="view" aria-labelledby="visit-title">
  <div class="container-x rail-grid visit__grid">
    <div class="visit__head">
      <h2 id="visit-title">Как нас найти</h2>
      <p class="visit__addr">
        {address.street}, 3&nbsp;этаж, ТРК&nbsp;PiterLand. Рядом картинг.
      </p>
      <p class="visit__hours">{hours}.</p>
    </div>

    <div class="poster visit__poster" data-tone="poster">
      <div class="poster-tex" aria-hidden="true"></div>
      <ol class="visit__route">
        <li class="tag tag--line tilt-a visit__s1" data-trail-pt="1" data-trail-at="0.5 0.5">
          <span class="tag__word">{address.street}</span>
          <span class="tag__cap">{address.city}</span>
        </li>
        <li class="tag tag--line tilt-b visit__s2" data-trail-pt="2" data-trail-at="0.5 0.5">
          <span class="tag__word">ТРК&nbsp;PiterLand</span>
          <span class="tag__cap">Рядом картинг</span>
        </li>
        <li class="tag tag--lg tilt-c visit__s3" data-trail-pt="3" data-trail-at="0.5 0.5">
          <span class="tag__word">3&nbsp;этаж</span>
          <span class="tag__cap">Кальянный lounge Rocket&nbsp;View</span>
        </li>
        <li class="tag tag--line tilt-d visit__s4" data-trail-pt="4" data-trail-at="0.5 0.5">
          <span class="tag__word">11:00–24:00</span>
          <span class="tag__cap">Ежедневно</span>
        </li>
      </ol>
    </div>

    <div class="visit__call-wrap">
      <a class="cta-call visit__call" href={`tel:${phone.e164}`} data-cta-final data-trail-pt="5" data-trail-at="0.92 0" data-trail-stop>
        Позвонить и спросить стол
        <span class="cta-call__num">{phone.display}</span>
      </a>
    </div>
    <ul class="visit__links">
      <li><a class="link-route" href={links.yandexMaps} target="_blank" rel="noopener">Маршрут в Яндекс.Картах</a></li>
      <li><a class="link-route" href={links.twoGis} target="_blank" rel="noopener">2ГИС</a></li>
      <li><a class="link-route" href={links.vk} target="_blank" rel="noopener">ВКонтакте</a></li>
    </ul>
  </div>
</section>

<style>
  .visit__grid { grid-template-areas: 'head' 'poster' 'call' 'links'; row-gap: var(--s-4); }
  .visit__head { grid-area: head; display: grid; gap: var(--s-4); align-content: start; }
  .visit__addr, .visit__hours {
    margin: 0; max-width: var(--measure); font-size: var(--t-body); line-height: var(--t-body-lh);
  }
  .visit__hours { font-weight: 600; }

  .visit__poster { grid-area: poster; }
  .visit__route {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: var(--s-8);
    padding-block: var(--s-4);
  }
  .visit__route > .tag { align-self: flex-start; }
  .visit__route > .visit__s2 { align-self: flex-end; }
  .visit__s3 { margin-left: var(--s-8); }

  .visit__call-wrap { grid-area: call; position: relative; padding-top: var(--s-16); }
  .visit__links {
    grid-area: links; list-style: none; margin: 0; padding: 0;
    display: flex; flex-wrap: wrap; column-gap: var(--s-8); align-content: flex-start;
  }

  @media (min-width: 64rem) {
    .visit__grid {
      grid-template-areas: 'head poster' 'call links';
      grid-template-rows: auto auto; row-gap: var(--s-4);
    }
    .visit__route > .visit__s3 { margin-left: 0; align-self: center; }
    .visit__links { align-self: end; }
  }
</style>
