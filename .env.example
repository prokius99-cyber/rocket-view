# Адрес сайта после выкладки (для sitemap и canonical)
PUBLIC_SITE_URL=https://example.ru
# false — когда сайт выкладывается на домен клиента (снимает noindex и запрет в robots.txt)
PUBLIC_DEMO=true
# Куда отправлять заявки (вебхук, серверная функция). Пусто — форма предлагает мессенджеры.
PUBLIC_ORDER_ENDPOINT=
